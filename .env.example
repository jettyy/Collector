# ===== 필수 =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
PORT=3000

# ===== Claude (AI 분류) =====
# 기본은 이 PC 에 로그인된 Claude Code(구독 계정)를 사용하므로 API 키가 필요 없습니다.
# 설치 후 한 번만: claude auth login  (확인: claude auth status)
# AI_PROVIDER=cli              # cli(구독) | api(API 키 과금) | off(휴리스틱만)
# AI_MODEL=sonnet              # opus / sonnet / haiku. 사용량을 더 아끼려면 haiku
# AI_EFFORT=low
# AI_CLI_PATH=claude           # PATH 에 없으면 전체 경로
# AI_CLI_TIMEOUT_MS=180000

# ===== 선택 (기본값) =====
# 대시보드 바인딩 주소. 같은 네트워크의 다른 기기에서 보려면 0.0.0.0
# HOST=127.0.0.1
# DB_PATH=data/trend.db

# 블로그봇 방 목록 "이름:chat_id" 쉼표 구분 → 알림 버튼으로 "주제: OOO" 전달
# BLOG_BOT_CHATS=요리블로그:-1001234567890,IT블로그:-1001234567891,생활블로그:-1001234567892
# FORWARD_TEMPLATE=주제: {keyword}
# TELEGRAM_POLLING=true
# TELEGRAM_API_ROOT=            # 로컬 Bot API 서버를 쓸 때만

# CRON_SCHEDULE=*/10 * * * *
# TZ_NAME=Asia/Seoul
# RUN_ON_START=true
# ENABLED_COLLECTORS=signalbz,googleTrends,naverNews,naverDatalab

# 필터
# EXCLUDE_POLITICS=true
# EXCLUDE_WORLD=false

# AI 분류 공통
# AI_MAX_ITEMS_PER_CALL=80
# LABEL_CACHE_HOURS=12

# AI_PROVIDER=api 일 때만 (종량 과금)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_EFFORT=low

# 알림 기준
# MIN_SCORE_TO_NOTIFY=1.2
# RENOTIFY_HOURS=6
# MAX_ALERTS_PER_RUN=5
# NOTIFY_ON_FIRST_RUN=false

# 네이버
# NAVER_SECTION_IDS=100,101,102,103,104,105
# NAVER_RANKING_PER_PRESS=3
# NAVER_DATALAB_CATEGORIES=50000003,50000008,50000006
# NAVER_DATALAB_TOP_N=10
# ARTICLES_PER_KEYWORD=3
# HTTP_TIMEOUT_MS=15000
